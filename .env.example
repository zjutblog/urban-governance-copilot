# ================= LLM（大模型，OpenAI 兼容）=================
# 默认云端 DeepSeek；也可指向本地 Ollama / vLLM（http://localhost:11434/v1）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-your-deepseek-key

# 质量门控采样数（CPU 调试可设 1；云端建议 3~5）
QUALITY_GATE_K=3

# ================= 视觉大模型（多模态识图，可选）=================
# 用于「上传现场照片 → 识图 → 走完整管线」。不填则该功能不可用，其余功能正常。
VLM_BASE_URL=https://api.moonshot.cn/v1
VLM_MODEL=your-vlm-model
VLM_API_KEY=sk-your-vlm-key

# ================= 高德地图（区县地图/瓦片，可选）=================
AMAP_KEY=your-amap-key

# ================= 说明 =================
# 1) 本项目大部分能力（案例检索 / 政策检索 / 单条快速分析 / 批量分析 / 看板 / 地图 / 月报）
#    不依赖大模型，**不填任何 key 也能离线运行**。
# 2) 只有「智能对话」「图片识图」需要 LLM / VLM key。
